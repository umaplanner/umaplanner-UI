{
  "headers": [
    {
      "source": "/:path*.:ext(avif|gif|jpe?g|png|svg|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!_vercel/).*)",
      "destination": "/"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
